{
  "name": "crystal-overdrive",
  "version": "0.1.0",
  "description": "Classic 90s handheld monster RPG web engine tribute",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build:maps": "node -e \"if(require('fs').existsSync('scripts/build-world-maps.cjs')) require('child_process').execSync('node scripts/build-world-maps.cjs', {stdio:'inherit'})\"",
    "build": "tsc && vite build && node scripts/build-offline-manifest.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "review": "node scripts/project-optimization-review.cjs"
  },
  "dependencies": {
    "@pixi/tilemap": "^5.0.2",
    "@pkmn/dex": "^0.8.0",
    "gsap": "^3.12.5",
    "howler": "^2.2.4",
    "idb": "^8.0.0",
    "pixi.js": "^8.5.2"
  },
  "devDependencies": {
    "@types/howler": "^2.2.11",
    "@types/node": "^22.8.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.3"
  }
}
